# Environment configuration for the Tango KYC Verification backend.
#
# Copy this file to `.env` for local tooling and to
# `supabase/functions/.env` for the local Edge Function runtime, then fill in
# the values. NEVER commit the real `.env` files: only `.env.example` is tracked.
#
# ---------------------------------------------------------------------------
# Where each value comes from
# ---------------------------------------------------------------------------
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
#   Supabase Dashboard -> Project Settings -> API
#   For the local stack, run:  supabase status -o env
#   The ANON key is public and is also placed in the Flutter build.
#   The SERVICE_ROLE key is a full-access secret: backend only, never Flutter.
#
# EMAIL_API_KEY
#   Resend Dashboard -> API Keys -> Create API Key
#   https://resend.com/api-keys
#   Free tier: 3,000 emails/month, 100/day. Backend only.
#   Used for BOTH directions: fetching the body of a received reply, and
#   sending outbound mail. RESEND_API_KEY (below) takes precedence for outbound
#   when set, so the two can be split later without touching code.
#
# RESEND_API_KEY
#   Optional. The outbound-only Resend key. When empty, EMAIL_API_KEY is used.
#
# RESEND_FROM_EMAIL
#   The outbound sender. Defaults to `onboarding@resend.dev`, Resend's shared
#   sandbox sender, which needs no domain and no DNS records.
#
#   IMPORTANT LIMIT: with `onboarding@resend.dev`, Resend only delivers to the
#   address that owns the Resend account. Any other recipient is refused with
#   HTTP 403. To mail arbitrary users, verify a domain at
#   https://resend.com/domains and set this to an address on it, e.g.
#   `Tango KYC Verification <kyc@yourdomain.com>`. Until then, outbound mail
#   only reaches the account owner's own address.
#
# EMAIL_INBOUND_DOMAIN / EMAIL_INBOUND_MAILBOX
#   The domain configured for inbound mail at https://resend.com/domains with
#   receiving enabled. Replies go to: <mailbox>+<reply_token>@<domain>
#   The `+<reply_token>` suffix is what lets the backend identify the ticket,
#   so replies are matched by token and never by the sender's address.
#
# RESEND_WEBHOOK_SECRET
#   Resend Dashboard -> Webhooks -> (your webhook) -> Signing Secret
#   Starts with `whsec_`. Used to verify every inbound webhook.
#
# ADMIN_EMAIL
#   The administration identity: the human who acts in the admin dashboard.
#   It is NOT the KYC support mailbox. Do not point the support role here.
#
# KYC_SUPPORT_EMAIL
#   The "société / support KYC" mailbox: it receives the KYC request once a
#   payment is approved, receives the user's in-app messages, and replies to
#   them. Replies from it are routed back to the same ticket by the tokenised
#   Reply-To. There is no fallback to ADMIN_EMAIL: an unset value fails loudly
#   instead of mailing KYC data to the wrong mailbox.
#   (KYC_RECIPIENT_EMAIL is accepted as an alias.)

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email: outbound (Resend) ---------------------------------------------
# Leave RESEND_FROM_EMAIL empty to use the `onboarding@resend.dev` sandbox
# sender, which can only deliver to the Resend account owner's own address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Email: outbound (Gmail REST API) -------------------------------------
# Set EMAIL_TRANSPORT=gmail to send through the Gmail API instead of Resend.
# SMTP ports are blocked on the Edge runtime, so the REST API over 443 is used.
# GMAIL_FROM_EMAIL must be the authenticated Gmail account; GMAIL_SENDER_NAME is
# the display name shown to recipients ("Tango KYC").
EMAIL_TRANSPORT=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=
GMAIL_SENDER_NAME=Tango KYC

# --- Email: inbound (Resend) ----------------------------------------------
EMAIL_API_KEY=
EMAIL_INBOUND_DOMAIN=
EMAIL_INBOUND_MAILBOX=reply
RESEND_WEBHOOK_SECRET=

# --- Application ----------------------------------------------------------
ADMIN_EMAIL=
KYC_SUPPORT_EMAIL=

# Anti-spam limits are NOT environment variables: they live in the `rate_limit`
# row of the `app_settings` table and are edited with SQL. See
# docs/SUPABASE_SETUP.md for the exact statements.
